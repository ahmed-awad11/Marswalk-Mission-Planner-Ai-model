# Marswalk Scientific AI Engine Configuration Example
# Copy to .env and populate with your credentials

# Google Gemini API Key (optional - falls back to offline deterministic mock provider if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational Boundaries
MAX_SLOPE_DEG=15.0
DEFAULT_K_SUIT=0.60
RAD_GALE_BASELINE_MGY_DAY=0.21
DONKI_LOOKBACK_DAYS=7
